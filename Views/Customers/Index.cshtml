@model List<MotoMobiNardo.Models.Customer>
@{ ViewData["Title"] = "Clients"; ViewData["PageHeading"] = "Clients"; }
<div class="page-toolbar"><p class="page-intro">Retrouvez les coordonnées de vos clients.</p><a asp-action="Create" class="btn btn-primary">＋ Ajouter un client</a></div>
<form method="get" class="search-bar"><span>⌕</span><input name="search" value="@ViewBag.Search" placeholder="Rechercher un nom ou un téléphone…" /><button type="submit">Rechercher</button></form>
<section class="panel list-panel"><div class="list-summary"><strong>@Model.Count client(s)</strong><span>FICHIER CLIENT</span></div>
@if (Model.Count == 0) { <div class="empty-state">Aucun client trouvé.</div> } else { <div class="table-responsive"><table class="table app-table"><thead><tr><th>CLIENT</th><th>TÉLÉPHONE</th><th>E-MAIL</th><th>ADRESSE</th><th class="text-end">ACTIONS</th></tr></thead><tbody>
@foreach (var customer in Model) { <tr><td><div class="entity-cell"><span class="customer-avatar">@customer.FullName.Substring(0, 1).ToUpperInvariant()</span><strong>@customer.FullName</strong></div></td><td>@customer.Phone</td><td>@(customer.Email ?? "—")</td><td>@(customer.Address ?? "—")</td><td class="text-end action-cell"><a asp-action="Edit" asp-route-id="@customer.Id" class="action-link">Modifier</a><form asp-action="Delete" asp-route-id="@customer.Id" method="post" class="inline-form" onsubmit="return confirm('Supprimer ce client ?')"><button class="action-link danger-link" type="submit">Supprimer</button></form></td></tr> }
</tbody></table></div> }</section>
