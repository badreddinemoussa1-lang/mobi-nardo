@model IReadOnlyList<MotoMobiNardo.Models.AcquisitionInquiry>
@{ ViewData["Title"] = "Demandes d’acquisition"; ViewData["PageHeading"] = "Demandes d’acquisition"; }
<section class="panel">
    <div class="panel-heading"><div><span class="eyebrow">PROSPECTS · PROJET MOBI NARDO</span><h2>Demandes reçues</h2></div><span>@Model.Count demande(s)</span></div>
    @if (Model.Count == 0) { <div class="empty-state"><h3>Aucune demande pour le moment.</h3><p>Les formulaires envoyés depuis la page d’acquisition s’afficheront ici.</p></div> }
    else {
        <div class="table-responsive"><table class="table"><thead><tr><th>Date UTC</th><th>Nom</th><th>E-mail</th><th>Entreprise</th><th>Message</th></tr></thead><tbody>
        @foreach (var inquiry in Model) { <tr><td>@inquiry.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td><td>@inquiry.Name</td><td><a href="mailto:@inquiry.Email">@inquiry.Email</a></td><td>@(inquiry.Company ?? "—")</td><td>@inquiry.Message</td></tr> }
        </tbody></table></div>
        <p class="text-muted small">Les coordonnées ne sont visibles que dans l’espace authentifié de l’équipe.</p>
    }
</section>
