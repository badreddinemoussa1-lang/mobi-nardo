@model MotoMobiNardo.Models.LoginViewModel
@{ Layout = null; }
<!DOCTYPE html><html lang="fr"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>Connexion · Moto Mobi Nardo</title><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" /><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body class="auth-page"><main class="auth-card"><a class="brand auth-brand" asp-controller="Home" asp-action="Index"><span class="brand-icon">M</span><span>MOTO MOBI<small>NARDO · GESTION</small></span></a><span class="eyebrow auth-kicker">ESPACE PROFESSIONNEL</span><h1>Bon retour.</h1><p class="auth-intro">Connectez-vous pour gérer votre activité.</p><form asp-action="Login" method="post"><input asp-for="ReturnUrl" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="field"><label asp-for="Email"></label><input asp-for="Email" autocomplete="username" placeholder="nom@entreprise.ma" /><span asp-validation-for="Email"></span></div><div class="field"><label asp-for="Password"></label><input asp-for="Password" autocomplete="current-password" placeholder="Votre mot de passe" /><span asp-validation-for="Password"></span></div><label class="remember-row"><input asp-for="RememberMe" /> Garder ma session ouverte</label><button class="btn btn-primary auth-submit" type="submit">Se connecter <span>→</span></button></form><div class="auth-foot">Accès réservé à l’équipe de la concession.</div></main></body></html>
