@model MotoMobiNardo.Models.SetupViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Configuration · Moto Mobi Nardo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-page">
    <main class="auth-card">
        <a class="brand auth-brand" asp-controller="Home" asp-action="Index"><span class="brand-icon">M</span><span>MOTO MOBI<small>NARDO · GESTION</small></span></a>
        <span class="eyebrow auth-kicker">PREMIÈRE CONFIGURATION</span>
        <h1>Créer le compte admin.</h1>
        <p class="auth-intro">Ce compte protège les données de votre concession. L’inscription se désactive après sa création.</p>
        <form asp-action="Setup" method="post">
            <input asp-for="BootstrapKey" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <div class="field"><label asp-for="Email"></label><input asp-for="Email" autocomplete="username" placeholder="nom@entreprise.ma" /><span asp-validation-for="Email"></span></div>
            <div class="field"><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" placeholder="12 caractères minimum" /><span asp-validation-for="Password"></span></div>
            <div class="field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Retapez le mot de passe" /><span asp-validation-for="ConfirmPassword"></span></div>
            <button class="btn btn-primary auth-submit" type="submit">Créer le compte <span>→</span></button>
        </form>
        <div class="auth-foot">Le mot de passe doit contenir au moins 12 caractères, avec majuscule, minuscule, chiffre et symbole.</div>
    </main>
</body>
</html>
