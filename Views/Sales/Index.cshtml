@model List<(MotoMobiNardo.Models.Sale Sale, string Motorcycle, string Customer)>
@{ ViewData["Title"] = "Ventes"; ViewData["PageHeading"] = "Ventes"; var total = Model.Where(x => !x.Sale.IsCancelled).Sum(x => x.Sale.Total); var activeCount = Model.Count(x => !x.Sale.IsCancelled); }
<div class="page-toolbar"><div><p class="page-intro">Historique des transactions de votre concession.</p></div><a asp-action="Create" class="btn btn-primary">＋ Enregistrer une vente</a></div>
<div class="sales-summary"><div><span>VENTES ACTIVES</span><strong>@activeCount</strong></div><div><span>CHIFFRE D’AFFAIRES</span><strong>@total.ToString("N0") <small>DH</small></strong></div></div>
<section class="panel list-panel"><div class="list-summary"><strong>Historique des ventes</strong><span>@Model.Count TRANSACTION(S)</span></div>
@if (Model.Count == 0) { <div class="empty-state">Aucune vente enregistrée pour le moment.</div> } else { <div class="table-responsive"><table class="table app-table"><thead><tr><th>RÉF.</th><th>CLIENT</th><th>MOTO</th><th>DATE</th><th>CANAL</th><th>QTÉ</th><th>REMISE</th><th>MONTANT</th><th class="text-end">ACTION</th></tr></thead><tbody>
@foreach (var row in Model) { <tr class="@(row.Sale.IsCancelled ? "cancelled-row" : "")"><td><span class="sale-ref">@row.Sale.InvoiceNumber</span><a asp-action="Invoice" asp-route-id="@row.Sale.Id" class="receipt-link">Facture PDF</a></td><td><strong>@row.Customer</strong></td><td>@row.Motorcycle</td><td>@row.Sale.SoldAt.ToString("dd/MM/yyyy")</td><td><span class="channel-tag">@row.Sale.Channel</span></td><td>@row.Sale.Quantity</td><td>@row.Sale.Discount.ToString("N0") DH</td><td class="amount">@row.Sale.Total.ToString("N0") DH</td><td class="text-end">@if (row.Sale.IsCancelled) { <span class="status-cancelled">Annulée</span> } else { <form asp-action="Cancel" asp-route-id="@row.Sale.Id" method="post" class="inline-form" onsubmit="return confirm('Annuler cette vente et remettre les motos en stock ?')"><button class="action-link danger-link" type="submit">Annuler</button></form> }</td></tr> }
</tbody></table></div> }</section>
