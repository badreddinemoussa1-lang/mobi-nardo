@model MotoMobiNardo.Models.Motorcycle
@{ ViewData["Title"] = "Modifier la moto"; ViewData["PageHeading"] = "Modifier la moto"; }
<p class="page-intro">Mettez à jour les informations de @Model.Brand @Model.Model.</p>
<section class="panel form-panel"><form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data"><input asp-for="Id" type="hidden" /><partial name="_Form" model="Model" /><div class="form-actions"><a asp-action="Index" class="btn btn-light">Annuler</a><button class="btn btn-primary" type="submit">Enregistrer les modifications <span>→</span></button></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
