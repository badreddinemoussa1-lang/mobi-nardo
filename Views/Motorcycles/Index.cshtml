@model List<MotoMobiNardo.Models.Motorcycle>
@{ ViewData["Title"] = "Catalogue motos"; ViewData["PageHeading"] = "Catalogue motos"; }
<div class="page-toolbar"><div><p class="page-intro">Toutes vos motos, leur prix et leur disponibilité.</p></div><a asp-action="Create" class="btn btn-primary">＋ Ajouter une moto</a></div>
<form method="get" class="search-bar"><span>⌕</span><input name="search" value="@ViewBag.Search" placeholder="Rechercher une marque ou un modèle…" /><button type="submit">Rechercher</button></form>
<section class="panel list-panel"><div class="list-summary"><strong>@Model.Count moto(s)</strong><span>CATALOGUE</span></div>
@if (Model.Count == 0) { <div class="empty-state">Aucune moto trouvée. Ajoutez votre premier modèle.</div> } else {
<div class="table-responsive"><table class="table app-table"><thead><tr><th>MOTO</th><th>ANNÉE</th><th>MOTORISATION</th><th>PRIX</th><th>STOCK</th><th class="text-end">ACTIONS</th></tr></thead><tbody>
@foreach (var moto in Model) { <tr><td><div class="entity-cell">@if (!string.IsNullOrWhiteSpace(moto.PhotoFileName)) { <img class="admin-list-photo" src="@Url.Action("Photo", "Media", new { id = moto.Id })" alt="" loading="lazy" /> } else { <span class="moto-avatar">🏍</span> }<span><strong>@moto.Brand @moto.Model</strong><small>@moto.Category · @moto.Condition · @moto.Description</small></span></div></td><td>@moto.Year</td><td>@moto.EngineCc cc</td><td class="amount">@moto.Price.ToString("N0") DH</td><td><span class="stock-pill @(moto.Stock <= 2 ? "low" : "")">@moto.Stock unité(s)</span></td><td class="text-end action-cell"><a asp-action="Edit" asp-route-id="@moto.Id" class="action-link">Modifier</a><form asp-action="Delete" asp-route-id="@moto.Id" method="post" class="inline-form" onsubmit="return confirm('Supprimer cette moto du catalogue ?')"><button class="action-link danger-link" type="submit">Supprimer</button></form></td></tr> }
</tbody></table></div> }
</section>
